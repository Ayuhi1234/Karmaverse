# KarmaVerse support service — copy to .env and fill in only what you use.
# With nothing set, the service runs in ZERO-COST mode: approved FAQ answers,
# no AI calls, no video. Never commit real keys.

# Answer engine: "faq" (default, free, answers word for word from faq/faqs.json)
# or "claude" (paid; Claude rewrites answers from the approved FAQs only).
SUPPORT_ANSWER_PROVIDER=faq

# Only for SUPPORT_ANSWER_PROVIDER=claude. Needs an Anthropic API key from
# console.anthropic.com (a claude.ai subscription does not include API access)
# and `npm install @anthropic-ai/sdk`.
ANTHROPIC_API_KEY=
SUPPORT_CLAUDE_MODEL=claude-opus-5-5

# Mascot video: "none" (default), "mock" (local testing) or "heygen" (paid).
SUPPORT_AVATAR_PROVIDER=none

# Only for SUPPORT_AVATAR_PROVIDER=heygen. HeyGen API credits are billed
# separately from a HeyGen web subscription.
HEYGEN_API_KEY=
# Photo avatar made once from the Earth Buddy PNG (POST /v3/avatars).
HEYGEN_AVATAR_ID=
# Voice from GET /v3/voices.
HEYGEN_VOICE_ID=
# Optional webhook HeyGen calls when a video finishes.
HEYGEN_CALLBACK_URL=

# Mock provider tuning (testing only).
SUPPORT_MOCK_RENDER_MS=1500
SUPPORT_MOCK_FAIL=false

# Limits.
SUPPORT_RATE_LIMIT_PER_MIN=20
SUPPORT_VIDEO_TIMEOUT_MS=600000
SUPPORT_VIDEO_MIN_POLL_MS=5000

# Languages with published FAQs (comma-separated). Add "hi" once Hindi FAQs exist.
SUPPORT_LANGUAGES=en

# Dev server port.
PORT=4100
