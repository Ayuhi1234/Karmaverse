{
  "expo": {
    "name": "KarmaVer$e",
    "slug": "KarmaCredits-RN",
    "version": "1.0.0",
    "scheme": "karmacoin",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#052e16"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.karmacredits.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KarmaVerse uses your location to auto-fill your pickup address and show pickup partners near you on the map.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.karmacredits.app",
      "versionCode": 10,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#052e16"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "KarmaVerse — Recycle & Earn Rewards in India",
      "shortName": "KarmaVerse",
      "lang": "en",
      "description": "India's first circular economy rewards platform. Schedule free doorstep pickups for plastic, paper, metal, e-waste & more, and earn KarmaCoins XP for every kg you recycle.",
      "themeColor": "#052e16",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "./plugins/withMappls",
      "./plugins/withIosModularHeaders",
      "./plugins/withIosSceneDelegate",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.152765471990-c56hvo7q6pkqgaje639q9bupvoq0sa55"
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "2040037600233582",
          "clientToken": "884043276ba41381b885f1daa4002741",
          "displayName": "KarmaVerse",
          "scheme": "fb2040037600233582",
          "advertiserIDCollectionEnabled": false,
          "autoLogAppEventsEnabled": false,
          "isAutoInitEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#15803d"
        }
      ],
      "expo-audio",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.mappls.** { *; }\n-keep interface com.mappls.** { *; }\n-dontwarn com.mappls.**\n-keep class com.mmi.** { *; }\n-dontwarn com.mmi.**\n-keep class com.facebook.** { *; }\n-dontwarn com.facebook.**\n-keep class com.reactnativegooglesignin.** { *; }\n-keep class com.google.android.gms.auth.** { *; }"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d1a85489-5abc-4474-8cb6-97fc0827bd58"
      }
    },
    "owner": "cinsin"
  }
}
